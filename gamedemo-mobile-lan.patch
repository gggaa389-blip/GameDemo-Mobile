diff --git a/mobile/tests/net_probe.gd b/mobile/tests/net_probe.gd
new file mode 100644
index 0000000..7bbf22d
--- /dev/null
+++ b/mobile/tests/net_probe.gd
@@ -0,0 +1,92 @@
+extends Node
+## Two-process LAN probe used to verify the real net_sync.gd replication code.
+##
+##   godot --headless --path . res://mobile/tests/NetProbe.tscn -- --host
+##   godot --headless --path . res://mobile/tests/NetProbe.tscn -- --join=127.0.0.1
+
+const HOST_DURATION := 16.0
+const CLIENT_DURATION := 8.0
+
+var role := ""
+var sync: Node
+var player: Node3D
+var elapsed := 0.0
+var samples := 0
+var worst := 0.0
+var total_err := 0.0
+var _last_count := 0
+var _last_pos := Vector3.ZERO
+var _have_last := false
+var max_jump := 0.0
+var _start := 0.0
+
+func _ready() -> void:
+	for arg in OS.get_cmdline_user_args():
+		if arg == "--host":
+			role = "host"
+		elif arg.begins_with("--join="):
+			role = "client"
+			_target_ip = arg.substr(7)
+	_setup.call_deferred()
+
+var _target_ip := "127.0.0.1"
+
+func _setup() -> void:
+	await get_tree().process_frame
+	player = get_node("PauseContainer/Player") as Node3D
+	sync = get_node("NetSync")
+	# Net (the autoload) already hosted / joined from the `--host` / `--join=`
+	# command line arguments, before this scene was created.
+	if role == "host":
+		print("PROBE_HOST_LISTENING")
+	else:
+		print("PROBE_CLIENT_CONNECTING")
+	_start = Time.get_ticks_msec() / 1000.0
+
+func _physics_process(delta: float) -> void:
+	if role == "" or player == null or sync == null:
+		return
+	elapsed += delta
+	var duration := HOST_DURATION if role == "host" else CLIENT_DURATION
+	if role == "host":
+		# Drive the local player along a known path so the client can measure
+		# how far the replicated puppet is from the truth.
+		player.global_position = Vector3(sin(elapsed * 1.2) * 6.0, 2.0, cos(elapsed * 1.2) * 6.0)
+		player.rotation.y = elapsed * 0.9
+	if elapsed > duration:
+		_finish()
+		return
+	if role == "client":
+		var buffer: Array = sync._buffer
+		if buffer.size() != _last_count and buffer.size() > 0:
+			_last_count = buffer.size()
+			samples += 1
+		var puppet := sync.puppet as Node3D
+		if puppet != null and is_instance_valid(puppet) and elapsed > 1.5:
+			if _have_last:
+				max_jump = maxf(max_jump, (puppet.global_position - _last_pos).length())
+			_last_pos = puppet.global_position
+			_have_last = true
+		if puppet != null and is_instance_valid(puppet) and buffer.size() > 2:
+			var now := Time.get_ticks_msec() / 1000.0
+			var state: Variant = sync.sample(buffer, now - sync.RENDER_DELAY)
+			if state != null:
+				var err: float = (puppet.global_position - (state.pos as Vector3)).length()
+				total_err += err
+				worst = maxf(worst, err)
+
+func _finish() -> void:
+	if role == "host":
+		print("PROBE_HOST_OK connected=%s" % str(Net.peer_connected_flag))
+		get_tree().quit(0 if Net.peer_connected_flag else 1)
+		return
+	var avg := total_err / maxf(1.0, float(samples))
+	var puppet_ok := sync.puppet != null and is_instance_valid(sync.puppet)
+	print("PROBE_CLIENT connected=%s puppet=%s packets=%d max_frame_jump=%.3f" % [
+		str(Net.peer_connected_flag), str(puppet_ok), sync.packets_received, max_jump
+	])
+	# 30 packets/s for 8 s ~= 240; a hotspot may lose a few, so require 60%.
+	var ok: bool = Net.peer_connected_flag and puppet_ok and sync.packets_received >= 130 and max_jump < 1.0
+	if ok:
+		print("NET_TEST_OK")
+	get_tree().quit(0 if ok else 1)
