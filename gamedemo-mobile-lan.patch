+++ b/mobile/tests/touch_test.gd
@@ -0,0 +1,174 @@
+extends Node
+## Headless verification of the mobile touch layer.
+##
+## Run:  godot --headless --path . res://mobile/tests/TouchTest.tscn
+## Exit code 0 = every check passed.
+
+var checks := 0
+var failures: Array[String] = []
+
+var _probe_motion: Array = []
+var _probe_clicks: Array = []
+
+class Probe extends Node:
+	var motions: Array = []
+	var clicks: Array = []
+	func _input(event: InputEvent) -> void:
+		if event is InputEventMouseMotion:
+			motions.append(event.relative)
+		elif event is InputEventMouseButton:
+			clicks.append([event.pressed, event.position])
+
+var probe: Probe
+
+func _ready() -> void:
+	_run.call_deferred()
+
+func check(condition: bool, what: String) -> void:
+	checks += 1
+	if not condition:
+		failures.append(what)
+		print("  FAIL  ", what)
+
+func approx(a: float, b: float, eps := 0.02) -> bool:
+	return absf(a - b) <= eps
+
+func _touch(index: int, pos: Vector2, pressed: bool) -> void:
+	var ev := InputEventScreenTouch.new()
+	ev.index = index
+	ev.position = pos
+	ev.pressed = pressed
+	Input.parse_input_event(ev)
+
+func _drag(index: int, pos: Vector2, relative: Vector2) -> void:
+	var ev := InputEventScreenDrag.new()
+	ev.index = index
+	ev.position = pos
+	ev.relative = relative
+	Input.parse_input_event(ev)
+
+func _run() -> void:
+	# A stand-in for the real game scene: the touch layer only activates its
+	# gameplay controls while a scene called "Game" is the current scene.
+	var game := Node.new()
+	game.name = "Game"
+	game.add_to_group("game_scene")
+	get_tree().root.add_child(game)
+
+	probe = Probe.new()
+	get_tree().root.add_child(probe)
+
+	# The headless display server reports a tiny window, which makes the engine
+	# stretch every parsed input event by a large factor. Turn the stretch off
+	# so that the coordinates we inject are the coordinates the layer sees
+	# (this mirrors a device with stretch/aspect = expand, where the factor is 1).
+	get_tree().root.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
+	get_tree().root.content_scale_aspect = Window.CONTENT_SCALE_ASPECT_IGNORE
+	await get_tree().process_frame
+	TouchUI._layout()
+
+	await get_tree().process_frame
+	await get_tree().process_frame
+
+	var size: Vector2 = TouchUI.get_viewport_rect().size
+	var joy_center: Vector2 = TouchUI._joy_center
+	var joy_radius: float = TouchUI._joy_radius
+	print("viewport ", size, " joystick ", joy_center, " r=", joy_radius)
+
+	# ---------------------------------------------------------- analog stick
+	_touch(0, joy_center + Vector2(joy_radius * 0.9, 0), true)
+	await get_tree().process_frame
+	check(Input.is_action_pressed("move_right"), "stick right -> move_right")
+	check(not Input.is_action_pressed("move_left"), "stick right -> move_left released")
+	check(Input.get_action_strength("move_right") > 0.6, "stick right -> analog strength")
+	check(not Input.is_action_pressed("move_up"), "stick right -> move_up released")
+
+	_drag(0, joy_center + Vector2(joy_radius * 0.9, -joy_radius * 0.9), Vector2(0, -joy_radius * 0.9))
+	await get_tree().process_frame
+	check(Input.is_action_pressed("move_up"), "stick up-right -> move_up")
+	check(Input.is_action_pressed("move_right"), "stick up-right -> move_right")
+
+	_drag(0, joy_center + Vector2(-joy_radius * 0.9, joy_radius * 0.9), Vector2(-joy_radius * 1.8, joy_radius * 1.8))
+	await get_tree().process_frame
+	check(Input.is_action_pressed("move_left"), "stick down-left -> move_left")
+	check(Input.is_action_pressed("move_down"), "stick down-left -> move_down")
+	check(not Input.is_action_pressed("move_right"), "stick down-left -> move_right released")
+	check(not Input.is_action_pressed("move_up"), "stick down-left -> move_up released")
+
+	_drag(0, joy_center + Vector2(joy_radius * 0.05, 0), Vector2(joy_radius * 0.95, 0))
+	await get_tree().process_frame
+	check(not Input.is_action_pressed("move_right"), "stick inside dead zone -> released")
+
+	_touch(0, joy_center, false)
+	await get_tree().process_frame
+	check(not Input.is_action_pressed("move_left"), "stick released -> all move actions off")
+
+	# -------------------------------------------------------- action buttons
+	var jump_center: Vector2 = TouchUI._buttons[0].center
+	_touch(1, jump_center, true)
+	await get_tree().process_frame
+	check(Input.is_action_pressed("jump"), "JUMP button -> jump action")
+	_touch(1, jump_center, false)
+	await get_tree().process_frame
+	check(not Input.is_action_pressed("jump"), "JUMP released -> jump action off")
+
+	var attack_center: Vector2 = TouchUI._buttons[1].center
+	_touch(2, attack_center, true)
+	await get_tree().process_frame
+	check(Input.is_action_pressed("attack"), "HIT button -> attack action")
+	_touch(2, attack_center, false)
+
+	var swap_center: Vector2 = TouchUI._buttons[2].center
+	_touch(3, swap_center, true)
+	await get_tree().process_frame
+	check(Input.is_action_pressed("swap_weapons"), "SWAP button -> swap_weapons action")
+	_touch(3, swap_center, false)
+
+	# --------------------------------------------------------- camera drag
+	probe.motions.clear()
+	probe.clicks.clear()
+	var cam_start := Vector2(size.x * 0.80, size.y * 0.30)
+	_touch(4, cam_start, true)
+	await get_tree().process_frame
+	_drag(4, cam_start + Vector2(60, 0), Vector2(60, 0))
+	await get_tree().process_frame
+	check(probe.motions.size() >= 1, "camera drag emits mouse motion")
+	var total := Vector2.ZERO
+	for m in probe.motions:
+		total += m
+	check(approx(total.x, 60, 1.0) and approx(total.y, 0, 1.0), "camera drag delta matches finger delta (%s)" % total)
+	check(not Input.is_action_pressed("move_right"), "camera drag does not move the character")
+	_drag(4, cam_start + Vector2(60, -40), Vector2(0, -40))
+	await get_tree().process_frame
+	_touch(4, cam_start + Vector2(60, -40), false)
+	await get_tree().process_frame
+	check(probe.motions.size() >= 2, "vertical camera drag emits second motion")
+	check(probe.clicks.is_empty(), "a real drag does not click the UI")
+
+	# ------------------------------------------------------------- UI taps
+	probe.clicks.clear()
+	var ui_pos := Vector2(size.x * 0.5, size.y * 0.25)
+	_touch(5, ui_pos, true)
+	await get_tree().process_frame
+	_touch(5, ui_pos, false)
+	await get_tree().process_frame
+	check(probe.clicks.size() >= 2, "tap forwards press + release to the GUI")
+	if probe.clicks.size() >= 2:
+		check(probe.clicks[0][0] == true and probe.clicks[1][0] == false, "tap press order is press->release")
+
+	# ------------------------------------------------------- focus loss
+	_touch(6, joy_center + Vector2(joy_radius * 0.9, 0), true)
+	await get_tree().process_frame
+	check(Input.is_action_pressed("move_right"), "stick pressed again")
+	TouchUI.release_all()
+	await get_tree().process_frame
+	check(not Input.is_action_pressed("move_right"), "release_all() clears held actions (focus loss)")
+
+	# ------------------------------------------------------------ summary
+	print("")
+	print("touch checks: %d  failures: %d" % [checks, failures.size()])
+	for f in failures:
+		print("  - ", f)
+	if failures.is_empty():
+		print("TOUCH_TEST_OK")
+	get_tree().quit(0 if failures.is_empty() else 1)
