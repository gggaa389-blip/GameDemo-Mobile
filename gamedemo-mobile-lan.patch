+		print("SMOKE_FAIL app scene missing")
+		get_tree().quit(1)
+		return
+	var node: Node = app.instantiate()
+	add_child(node)
+	await get_tree().create_timer(3.0).timeout
+	print("SMOKE_APP_OK children=", node.get_child_count(), " touch_ui=", TouchUI != null, " net=", Net != null)
